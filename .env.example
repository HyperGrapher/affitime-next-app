# ── Database (Neon: DATABASE_URL = pooled endpoint, DIRECT_URL = direct endpoint) ──
DATABASE_URL="postgresql://affitime:affitime@localhost:5432/affitime"
DIRECT_URL="postgresql://affitime:affitime@localhost:5432/affitime"

# ── Auth (Better Auth) – generate with: openssl rand -base64 32 ──
BETTER_AUTH_SECRET=""

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enables one-click demo logins on /signin. NEVER enable on a public production site.
DEMO_MODE="true"

# ── Simulated payment provider callback signing ──
PAYMENT_WEBHOOK_SECRET=""

# ── Vercel Cron (Authorization: Bearer <CRON_SECRET>) ──
CRON_SECRET=""

# ── Uploads (optional; Vercel Blob). Without it, local dev stores files under public/uploads ──
BLOB_READ_WRITE_TOKEN=""
