    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.32.2",
    "@trpc/server": "^11.32.2",
    "@trpc/tanstack-react-query": "^11.32.2",
    "@vercel/blob": "^2.9.0",
    "axios": "^1.21.1",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "isbot": "^5.2.4",
    "lucide-react": "^1.82.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
