    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
