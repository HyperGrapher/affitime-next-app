// COMMANDS
// npx prisma migrate dev --name init
// npx prisma format
// npx prisma db push
// npx prisma generate
// npx prisma studio
// npx prisma migrate reset (Reset DB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum Role {
  PARTNER
  VENDOR
  ADMIN
  MODERATOR
}

enum PackageType {
  NONE
  BASIC
  MEDIUM
  ADVANCED
  OTHER
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Payment {
  id          String       @id @default(cuid())
  userId      String
  amount      Float
  packageType PackageType? @default(BASIC)
  user        User         @relation(fields: [userId], references: [id])
  error       Boolean      @default(false)
  errorReason String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([id, userId])
}

model User {
  id            String       @id @default(cuid())
  fname         String?
  lname         String?
  email         String       @unique
  password      String
  role          Role         @default(PARTNER)
  vendor_id     String?
  partner_id    String?
  emailVerified DateTime?
  image         String?      @db.Text
  accounts      Account[]
  sessions      Session[]
  payments      Payment[]
  vendor        Vendor?
  partner       Partner?
  active        Boolean      @default(true)
  trial         Boolean      @default(true)
  pro           Boolean      @default(false)
  packageType   PackageType? @default(BASIC)
  proDetails    Json?
  ipdata        Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([id, email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vendor {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id])
  userId        String         @unique
  brand         String         @unique()
  website       String         @unique()
  products      Product[]
  links         Link[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([id, userId])
  @@map("user_vendor")
}

model Partner {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id])
  userId        String         @unique
  username      String         @unique
  links         Link[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([id, userId])
  @@map("user_partner")
}

enum CommissionType {
  CASH
  PERC
}

model Tag {
  id       Int              @id @default(autoincrement())
  name     String
  products TagsOnProducts[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
  links    Link[]
}

model TagsOnProducts {
  product   Product @relation(fields: [productId], references: [id])
  productId String
  tag       Tag     @relation(fields: [tagId], references: [id])
  tagId     Int

  @@id([productId, tagId])
}

model Product {
  id                String           @id @default(cuid())
  title             String?          @db.Text
  desc              String?          @db.Text
  fullDesc          String?          @db.Text
  price             Float?
  cookieLife        Int              @default(60)
  perClick          Float?
  perClickType      CommissionType   @default(CASH)
  perSale           Float?
  perSaleType       CommissionType   @default(CASH)
  vendor            Vendor           @relation(fields: [vendor_profile_id], references: [id])
  vendor_profile_id String
  vendor_user_id    String?
  product_url       String?          @db.Text
  image             String?          @db.Text
  links             Link[]           @relation("ProductLinks")
  tags              TagsOnProducts[]
  category          Category         @relation(fields: [categoryId], references: [id])
  categoryId        Int
  published         Boolean?         @default(true)
  active            Boolean?         @default(true)
  extra_info        Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([id, vendor_profile_id])
}

model Visit {
  id           String   @id @default(cuid())
  link         Link     @relation("LinkVisits", fields: [link_id], references: [id])
  link_id      String
  partner_id   String? // maybe used for total calcs
  vendor_id    String? // maybe used for total calcs
  visiterIp    String?
  ipInfo       Json?
  country      String   @default("tr")
  cookieInfo   Json?
  isSold       Boolean  @default(false)
  isUnique     Boolean  @default(true)
  params       String? // Link query extras
  dubious      Boolean? //
  dubiousCause String? //
  partnerVisit Boolean? //
  paid         Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([id, link_id])
}

model Link {
  id                String   @id @default(cuid())
  product           Product  @relation("ProductLinks", fields: [product_id], references: [id])
  product_id        String
  partner           Partner  @relation(fields: [partner_id], references: [id])
  partner_id        String
  partner_user_id   String?
  vendor            Vendor   @relation(fields: [vendor_id], references: [id])
  vendor_id         String
  vendor_user_id    String?
  category          Category @relation(fields: [categoryId], references: [id])
  categoryId        Int
  url               String   @unique()
  platform          String?
  visits            Visit[]  @relation("LinkVisits")
  count             Int      @default(0)
  partnerVisitCount Int      @default(0)
  declined          Int      @default(0)
  repeated          Int      @default(0)
  active            Boolean? // vendor active/pasif yapabilir. partner pasif hale alabilir ama tekrar active yapamaz
  confirmed         Boolean? // by vendor
  vendor_notified   Boolean  @default(false)
  partner_notified  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([id, vendor_id, partner_id, product_id, url])
}

model UserIps {
  id         Int      @id @default(autoincrement())
  url        String
  ip         String
  country    String
  isUser     Boolean
  isVpn      Boolean
  user_id    String?
  partner_id String?
  vendor_id  String?
  ipInfo     Json?
  createdAt  DateTime @default(now())

  @@index([id, url, ip])
}

model Notification {
  id Int @id @default(autoincrement())

  message    String
  for        Role     @default(PARTNER)
  read       Boolean  @default(false)
  
  partner    Partner  @relation(fields: [partner_id], references: [id])
  partner_id String
  vendor     Vendor   @relation(fields: [vendor_id], references: [id])
  vendor_id  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // @@index([id, url, ip])
}
