// Affitime data model (PostgreSQL).
// Workflow: `npm run db:migrate` (dev) · `npm run db:deploy` (prod/Neon) · `npm run db:seed`.
// Connection strings live in env: DATABASE_URL (pooled) and DIRECT_URL (migrations). See prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  VENDOR
  PARTNER
  ADMIN
  MODERATOR
}

enum PlanType {
  TRIAL
  BASIC
  PRO
  ULTIMATE
}

enum CommissionType {
  CASH
  PERCENT
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum LinkStatus {
  AWAITING
  CONFIRMED
  REQUEST_DENIED
  PAUSED_BY_VENDOR
  CANCELED_BY_VENDOR
  CANCELED_BY_PARTNER
  CANCELED_BY_ADMIN
  PRODUCT_ARCHIVED
  PRODUCT_NOT_ACTIVE // vendor trial/plan ended
}

enum VisitFlag {
  BOT
  NO_USER_AGENT
  SELF_PARTNER
  SELF_VENDOR
  STAFF
  KNOWN_IP
}

enum PaymentKind {
  PLAN
  CAMPAIGN
  PAYOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CampaignStatus {
  ACTIVE
  ENDED
}

enum NotificationType {
  WELCOME
  LINK_REQUESTED
  LINK_APPROVED
  LINK_DENIED
  LINK_PAUSED
  LINK_RESUMED
  LINK_CANCELED
  PRODUCT_ARCHIVED
  PAYOUT_SENT
  PAYOUT_RECEIVED
  PLAN_ACTIVATED
  PLAN_ENDING_SOON
  PLAN_ENDED
  TRIAL_ENDING_SOON
  TRIAL_ENDED
  CAMPAIGN_STARTED
  CAMPAIGN_ENDED
}

enum EmailKind {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
  LINK_REQUESTED
  LINK_APPROVED
  LINK_DENIED
  TRIAL_ENDING_SOON
  TRIAL_ENDED
  PLAN_ENDING_SOON
  PLAN_ENDED
  CAMPAIGN_ENDED
  PAYMENT_RECEIPT
  PAYOUT_RECEIVED
  CONTACT_RECEIPT
}

// ───────────────────────── Auth (Better Auth) ─────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(PARTNER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  vendor        Vendor?
  partner       Partner?
  notifications Notification[]
  knownIps      KnownIp[]
  emailQueue    EmailQueue[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ───────────────────────── Profiles ─────────────────────────

model Vendor {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand         String    @unique
  website       String    @unique
  phone         String?
  logo          String?
  plan          PlanType  @default(TRIAL)
  trialEndsAt   DateTime
  planValidTill DateTime? // set when a paid plan is active
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products  Product[]
  links     Link[]
  visits    Visit[]
  payments  Payment[]
  campaigns Campaign[]
  apiKey    ApiKey?
  taxInfo   TaxInfo?

  @@map("vendor")
}

model Partner {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String   @unique
  phone      String?
  avatar     String?
  ibanHolder String?
  iban       String?
  interests  String[]
  socials    Json     @default("[]") // [{ platform, handle }]
  onboarded  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  links   Link[]
  visits  Visit[]
  payouts Payment[]

  @@map("partner")
}

model TaxInfo {
  id        String   @id @default(cuid())
  vendorId  String   @unique
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title     String? // unvan
  firstName String
  lastName  String
  tckn      String?
  vkn       String?
  taxOffice String?
  address   String
  city      String?
  country   String   @default("TR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_info")
}

model ApiKey {
  id          String    @id @default(cuid())
  vendorId    String    @unique
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  keyHash     String    @unique // sha256 of the secret; the secret is shown once
  prefix      String // first chars, for display
  installedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("api_key")
}

// ───────────────────────── Catalogue ─────────────────────────

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("category")
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]

  @@map("tag")
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tag")
}

model Product {
  id                  String         @id @default(cuid())
  vendorId            String
  vendor              Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId          Int
  category            Category       @relation(fields: [categoryId], references: [id])
  title               String
  summary             String
  description         String?
  image               String?
  productUrl          String
  price               Decimal        @db.Decimal(12, 2)
  cookieDays          Int            @default(30)
  clickCommission     Decimal        @default(0) @db.Decimal(12, 2)
  clickCommissionType CommissionType @default(CASH)
  saleCommission      Decimal        @default(0) @db.Decimal(12, 2)
  saleCommissionType  CommissionType @default(PERCENT)
  status              ProductStatus  @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tags      ProductTag[]
  links     Link[]
  visits    Visit[]
  campaigns Campaign[]
  payments  Payment[]

  @@index([vendorId, status, createdAt])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("product")
}

// A paid "marketplace" campaign: pushes a product to the top of the partner marketplace.
model Campaign {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  paymentId String         @unique
  payment   Payment        @relation(fields: [paymentId], references: [id])
  days      Int
  startsAt  DateTime
  endsAt    DateTime
  status    CampaignStatus @default(ACTIVE)
  createdAt DateTime       @default(now())

  @@index([status, endsAt])
  @@index([productId])
  @@index([vendorId])
  @@map("campaign")
}

// ───────────────────────── Tracking ─────────────────────────

model Link {
  id            String      @id @default(cuid())
  code          String      @unique // public tracking code used in /r/[code]
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status        LinkStatus  @default(AWAITING)
  suspendedFrom LinkStatus? // status to restore when the vendor plan becomes active again
  platform      String?

  // Terms snapshot taken at request time
  cookieDays          Int
  clickCommission     Decimal        @db.Decimal(12, 2)
  clickCommissionType CommissionType
  saleCommission      Decimal        @db.Decimal(12, 2)
  saleCommissionType  CommissionType
  productPrice        Decimal        @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]

  @@unique([productId, partnerId])
  @@index([vendorId, status])
  @@index([partnerId, status])
  @@map("link")
}

model Visit {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  ipHash     String
  ipMasked   String?
  country    String     @default("-")
  userAgent  String?
  browser    String?
  os         String?
  referer    String?
  params     String?
  hasCookie  Boolean    @default(false)
  isUnique   Boolean    @default(true)
  flag       VisitFlag?
  // billable = unique, not flagged. Snapshot of what this click earns the partner.
  billable   Boolean    @default(false)
  commission Decimal    @default(0) @db.Decimal(12, 2)
  payoutId   String?
  payout     Payment?   @relation(fields: [payoutId], references: [id])

  @@index([linkId, createdAt])
  @@index([vendorId, createdAt])
  @@index([partnerId, createdAt])
  @@index([vendorId, partnerId, billable, payoutId])
  @@index([payoutId])
  @@map("visit")
}

// IPs seen when partners/vendors/admins sign in; clicks from them are flagged as self-clicks.
model KnownIp {
  id         String   @id @default(cuid())
  ipHash     String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@unique([ipHash, userId])
  @@index([ipHash])
  @@map("known_ip")
}

// ───────────────────────── Payments ─────────────────────────

// One table for the three flows: PLAN (vendor → platform), CAMPAIGN (vendor → platform),
// PAYOUT (vendor → partner commissions). Provider specifics live in `providerData` only.
model Payment {
  id            String        @id @default(cuid())
  ref           String        @unique // merchant order reference (merchant_oid)
  kind          PaymentKind
  status        PaymentStatus @default(PENDING)
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal?      @db.Decimal(12, 2) // incl. instalment surcharge
  currency      String        @default("TRY")
  installments  Int           @default(1)
  cardBrand     String?
  testMode      Boolean       @default(true)
  description   String
  failureCode   String?
  failureReason String?
  providerData  Json?
  buyerName     String
  buyerPhone    String?
  buyerAddress  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  // PLAN
  plan         PlanType?
  annual       Boolean?
  validFrom    DateTime?
  validTill    DateTime?
  // CAMPAIGN
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id])
  campaign     Campaign?
  campaignDays Int?
  // PAYOUT
  partnerId    String?
  partner      Partner?  @relation(fields: [partnerId], references: [id])
  ibanHolder   String?
  iban         String?
  visits       Visit[]

  @@index([vendorId, kind, createdAt])
  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@map("payment")
}

// ───────────────────────── Messaging ─────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}") // { linkId, productTitle, partner, amount, ... } – text is rendered from i18n
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

model SentEmail {
  id        String    @id @default(cuid())
  kind      EmailKind
  to        String
  toName    String?
  subject   String
  html      String
  text      String
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([to])
  @@map("sent_email")
}

// Scheduled e-mails produced by the daily cron. (userId, kind, refDate) makes the job idempotent.
model EmailQueue {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailKind
  refDate   DateTime // the trial / plan / campaign end this mail is about
  meta      Json? // template variables (product title, plan name…)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, kind, refDate])
  @@index([sentAt])
  @@map("email_queue")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
  @@map("faq")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
  @@map("contact_message")
}
